# 이 파일은 견본입니다. 복사해서 `.env`를 만들고 실제 값은 `.env`에만 넣으세요 (.env는 git에서 제외됨).
# 주석은 반드시 별도 줄에 쓰세요. `값 # 설명`처럼 같은 줄에 쓰면 값이 깨질 수 있습니다.

# --- LLM ---
# 방식 선택: auto(기본) | anthropic | openai
# auto: API_KEY, API_BASE, API_MODEL이 모두 있으면 OpenAI 호환 서비스, 없으면 Claude
LLM_PROVIDER=auto

# (A) OpenAI 호환 서비스 (GPT형 API)
API_KEY=
# 보통 /v1까지 포함한 주소 (SDK가 뒤에 /chat/completions를 붙여 호출)
API_BASE=
# 서비스가 제공하는 모델 이름. 모든 단계(T1~T5, Connector D)가 이 모델을 사용
API_MODEL=
# 선택. 응답이 잘리면 늘리세요. 비우면 서비스 기본값
API_MAX_TOKENS=
# 스트리밍 응답 사용(기본 1). 긴 응답이 게이트웨이 시간 제한(504)에 걸리는 것을 막아 줍니다. 서비스가 지원하지 않으면 0
API_STREAM=1
# 추론 강도(low|medium|high). 낮을수록 빠릅니다 (기본 low). 서비스가 거부하면 자동으로 빼고 재시도합니다. 보내지 않으려면 비우세요
API_EFFORT=low

# (B) Claude
ANTHROPIC_API_KEY=
# T1~T5 모델
PINPLAY_MODEL=claude-opus-5-5
# Connector D 경량 파서
PINPLAY_PARSER_MODEL=claude-haiku-5-5

# --- 공공데이터포털 (data.go.kr) ---
# TourAPI 4.0(한국관광공사 국문 관광정보)와 전국문화축제표준데이터 활용신청 후 발급되는 "Decoding" 서비스키
DATA_GO_KR_KEY=
# KorService2(현행). 구버전(KorService1)은 폐기되어 호출되지 않습니다
TOURAPI_VERSION=2
# 전국문화축제표준데이터 CSV 경로 (파일 데이터: data.go.kr에서 내려받아 이 경로에 저장). 파일이 없으면 이 소스만 건너뜁니다
MOIS_FESTIVAL_FILE=data/festival_standard.csv

# --- 영화진흥위원회 KOBIS 오픈API (kobis.or.kr/kobisopenapi) ---
KOBIS_KEY=

# --- 카카오 디벨로퍼스 (REST API 키, 카카오맵/로컬 사용 설정 필요) ---
KAKAO_REST_KEY=
# 카카오맵 JavaScript 키 (지도를 카카오맵으로 표시). 앱 설정의 Web 플랫폼에 사이트 주소(예: http://localhost:8000)를 등록해야 동작합니다.
# 비어 있으면 OpenFreeMap으로 표시합니다. 이 키는 브라우저에 공개되는 키입니다 (비밀 키 아님).
KAKAO_JS_KEY=

# --- 네이버 검색 API (플리마켓·가오픈 수집) ---
# hub: 네이버 클라우드 API Hub에서 발급한 키 (기본)
# developers: 네이버 개발자센터(developers.naver.com)에서 발급한 키
NAVER_API_MODE=hub
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- Supabase (서버 전용: service_role 키는 절대 프론트엔드에 노출하지 마세요) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- 공개 배포 보호 ---
# LLM을 부르는 라우트(/pipeline, /reroute, /parse)의 IP당 10분 허용 횟수. 0이면 제한 없음 (기본 20)
RATE_LIMIT=20

# --- 관리자 ---
# POST /harvest 호출 시 X-Admin-Token 헤더 값. 비워 두면 /harvest 비활성화
ADMIN_TOKEN=
